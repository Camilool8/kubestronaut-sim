{
  "startupProbe": {
    "failureThreshold": 30,
    "httpGet": {
      "path": "/",
      "port": 80,
      "scheme": "HTTP"
    },
    "periodSeconds": 2,
    "successThreshold": 1,
    "timeoutSeconds": 1
  },
  "readinessProbe": {
    "failureThreshold": 2,
    "httpGet": {
      "path": "/",
      "port": 80,
      "scheme": "HTTP"
    },
    "periodSeconds": 5,
    "successThreshold": 1,
    "timeoutSeconds": 1
  },
  "livenessProbe": {
    "failureThreshold": 3,
    "httpGet": {
      "path": "/",
      "port": 80,
      "scheme": "HTTP"
    },
    "initialDelaySeconds": 10,
    "periodSeconds": 10,
    "successThreshold": 1,
    "timeoutSeconds": 1
  }
}
