{
  "livenessProbe": {
    "httpGet": {
      "path": "/",
      "port": 80
    },
    "initialDelaySeconds": 10,
    "periodSeconds": 10
  },
  "readinessProbe": {
    "failureThreshold": 2,
    "httpGet": {
      "path": "/",
      "port": 80
    },
    "periodSeconds": 5
  },
  "startupProbe": {
    "failureThreshold": 30,
    "httpGet": {
      "path": "/",
      "port": 80
    },
    "periodSeconds": 2
  }
}
