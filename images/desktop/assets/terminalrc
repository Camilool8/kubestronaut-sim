[Configuration]
FontName=JetBrains Mono 11
MiscMenubarDefault=FALSE
# Candidates paste exam values (resource names, paths, image tags) from
# the question panel constantly, and anything containing a newline
# otherwise raises "Warning: Potentially Unsafe Paste". The warning
# guards against pasting an unread command from the web; here the only
# source is the exam's own question text, so it is pure friction.
# (xfce4-terminal reads this file up to 1.0.x; 1.1+ migrates it into the
# xfconf channel seeded alongside it.)
MiscShowUnsafePasteDialog=FALSE
MiscBordersDefault=TRUE
ScrollingUnlimited=TRUE
# This palette is the --machine-* family from ui/src/styles/tokens.css,
# not the app's dark theme. The terminal IS the machine, and the machine
# does not follow the app's theme — see the note at the top of that file.
# Green and amber here are --machine-green and --machine-amber, which are
# also the dark --syntax-string and --syntax-number, so a YAML block in
# the question panel and the same YAML in the candidate's vim are the
# same two colours. Keep the xfconf twin next door in step.
ColorForeground=#c3ccd9
ColorBackground=#0b0f16
ColorCursor=#6f9cf8
ColorPalette=#161d2b;#e5605a;#63d68a;#e8c46a;#6f9cf8;#c792ea;#5fd0e0;#c3ccd9;#6b7a90;#e5605a;#8fd6a8;#e8c46a;#9dbcff;#c792ea;#8fe0ec;#f0f4fa
