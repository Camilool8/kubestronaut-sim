[Configuration]
FontName=JetBrains Mono 11
MiscMenubarDefault=FALSE
# Candidates paste exam values (resource names, paths, image tags) from
# the question panel constantly, and anything containing a newline
# otherwise raises "Warning: Potentially Unsafe Paste". The warning
# guards against pasting an unread command from the web; here the only
# source is the exam's own question text, so it is pure friction.
# (xfce4-terminal reads this file up to 1.0.x; 1.1+ migrates it into the
# xfconf channel seeded alongside it.)
MiscShowUnsafePasteDialog=FALSE
MiscBordersDefault=TRUE
ScrollingUnlimited=TRUE
ColorForeground=#d9dee5
ColorBackground=#0b1220
ColorCursor=#7aa2f7
ColorPalette=#121a2b;#e5605a;#57d183;#e0a850;#7aa2f7;#c792ea;#5fd0e0;#d9dee5;#57626f;#e5605a;#57d183;#e0a850;#a4c0fb;#c792ea;#8fe0ec;#f7f9fc
