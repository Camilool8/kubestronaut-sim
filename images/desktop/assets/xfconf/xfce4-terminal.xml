<?xml version="1.0" encoding="UTF-8"?>
<!-- xfce4-terminal 1.1+ reads its settings from this xfconf channel and
     only migrates assets/terminalrc if the channel does not already
     exist. Debian 12 ships 1.0.4, which uses the rc file — both are
     shipped so the image keeps behaving the same if the base image's
     terminal is ever newer. Keep the two in sync. -->
<channel name="xfce4-terminal" version="1.0">
  <property name="misc-show-unsafe-paste-dialog" type="bool" value="false"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-borders-default" type="bool" value="true"/>
  <property name="scrolling-unlimited" type="bool" value="true"/>
  <property name="font-name" type="string" value="JetBrains Mono 11"/>
  <!-- The --machine-* family from ui/src/styles/tokens.css. color-palette
       was previously absent here while terminalrc declared one, so a
       1.1+ terminal fell back to the built-in palette and the two files
       were only nominally in sync. -->
  <property name="color-foreground" type="string" value="#c3ccd9"/>
  <property name="color-background" type="string" value="#0b0f16"/>
  <property name="color-cursor" type="string" value="#6f9cf8"/>
  <property name="color-palette" type="string" value="#161d2b;#e5605a;#63d68a;#e8c46a;#6f9cf8;#c792ea;#5fd0e0;#c3ccd9;#6b7a90;#e5605a;#8fd6a8;#e8c46a;#9dbcff;#c792ea;#8fe0ec;#f0f4fa"/>
</channel>
