#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
cmd=${1:-help}

UI=http://localhost:8080

json_field() { python3 -c "import json,sys; print(json.load(sys.stdin).get('$1',''))" 2>/dev/null || true; }

case "$cmd" in
  up)

    BANK=${2:-} docker compose up -d --build

    budget=${SIM_BOOT_BUDGET:-3600}
    deadline=$((SECONDS + budget))
    last=""
    if [ -z "${2:-}" ]; then

      shell_deadline=$((SECONDS + ${SIM_SHELL_BUDGET:-300}))
      while :; do
        if [ "$SECONDS" -ge "$shell_deadline" ]; then
          echo
          echo "The environment did not finish starting up. Check with:"
          echo "  docker compose logs k8s-env"
          exit 1
        fi
        boot=$(curl -fsS --max-time 5 "${UI}/api/boot" 2>/dev/null) || { sleep 2; continue; }
        state=$(printf '%s' "$boot" | json_field state)
        label=$(printf '%s' "$boot" | json_field label)
        if [ -n "$label" ] && [ "$label" != "$last" ]; then
          echo "  $label"
          last="$label"
        fi
        case "$state" in
          idle)
            echo "Ready. Choose an exam at ${UI} — its environment is built when you pick one."
            exit 0 ;;
          ready)

            echo "Exam environment ready. Exam UI: ${UI} — or ./sim ssh instance-1"
            exit 0 ;;
          failed)
            echo
            echo "The environment failed to start:"
            printf '  %s\n' "$(printf '%s' "$boot" | json_field error)"
            echo
            echo "Full output:  docker compose logs k8s-env"
            exit 1 ;;
        esac
        sleep 2
      done
    fi
    echo "Building the exam environment (first run pulls and seeds; later runs resume)..."
    while :; do
      if [ "$SECONDS" -ge "$deadline" ]; then
        echo
        echo "Gave up waiting after ${budget}s. The environment may still be working;"
        echo "check with:  docker compose logs -f k8s-env"
        echo "Raise the budget with SIM_BOOT_BUDGET=<seconds> ./sim up"
        exit 1
      fi

      boot=$(curl -fsS --max-time 5 "${UI}/api/boot" 2>/dev/null) || { sleep 3; continue; }
      state=$(printf '%s' "$boot" | json_field state)
      label=$(printf '%s' "$boot" | json_field label)
      detail=$(printf '%s' "$boot" | json_field detail)

      line="$label"
      [ -n "$detail" ] && line="$label — $detail"
      if [ "$line" != "$last" ] && [ -n "$line" ]; then
        echo "  $line"
        last="$line"
      fi

      case "$state" in
        ready) break ;;
        failed)
          echo
          echo "The environment failed to start:"
          printf '  %s\n' "$(printf '%s' "$boot" | json_field error)"
          echo
          echo "Full output:  docker compose logs k8s-env"
          exit 1 ;;
      esac
      sleep 3
    done
    echo "Exam environment ready. Exam UI: ${UI} — or ./sim ssh instance-1" ;;
  down)  docker compose down --remove-orphans ;;
  purge)

    case "${2:-}" in
      "")

        project=$(docker compose config --format json 2>/dev/null | json_field name)
        if [ -z "$project" ]; then
          echo "Could not determine the compose project name; refusing to guess which"
          echo "volumes are ours. Nothing was removed — the environment is untouched."
          echo "Remove everything, attempt history included, with: ./sim purge --all"
          exit 1
        fi
        docker compose down --remove-orphans
        kept=0
        for vol in $(docker volume ls -q --filter "label=com.docker.compose.project=${project}"); do
          key=$(docker volume inspect -f '{{index .Labels "com.docker.compose.volume"}}' "$vol" 2>/dev/null || true)
          if [ "$key" = "state" ]; then kept=1; continue; fi
          docker volume rm "$vol" >/dev/null || echo "  could not remove ${vol} (still in use?)"
        done
        if [ "$kept" = "1" ]; then
          echo "Purged. Attempt history was kept — remove it too with: ./sim purge --all"
        else
          echo "Purged. There was no attempt history to keep."
        fi ;;
      --all)
        echo "Removing EVERY volume, including attempt history: every attempt graded on"
        echo "this machine is deleted, there is no backup, and there is no undo."
        echo "(Export it first from the app if you want to keep it.)"
        docker compose down -v --remove-orphans
        echo "Purged, attempt history included." ;;
      *)
        echo "usage: ./sim purge [--all]" >&2
        exit 1 ;;
    esac ;;
  doctor)

    echo "kubestronaut-sim preflight"
    echo
    os=$(uname -s)
    case "$os" in
      Darwin) host="macOS" ;;
      Linux)
        if grep -qi microsoft /proc/version 2>/dev/null; then host="WSL"; else host="Linux"; fi ;;
      *) host="$os" ;;
    esac
    printf 'host              : %s\n' "$host"
    printf 'docker            : '; docker version --format '{{.Server.Version}}' 2>/dev/null || echo "NOT REACHABLE"
    printf 'compose           : '; docker compose version --short 2>/dev/null || echo "MISSING"
    printf 'container OS      : '
    ostype=$(docker info --format '{{.OSType}}' 2>/dev/null || echo unknown)
    if [ "$ostype" = "linux" ]; then
      echo "linux   ok"
    else
      echo "${ostype}   << must be linux — switch Docker Desktop to Linux containers"
    fi
    printf 'python3           : '; python3 --version 2>/dev/null || echo "MISSING (./sim up needs it)"

    mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
    memgb=$(( mem / 1024 / 1024 / 1024 ))
    printf 'RAM to docker     : %sGB' "$memgb"
    if [ "$memgb" -lt 8 ]; then
      case "$host" in
        WSL) echo "   << LOW: raise it in %UserProfile%\\.wslconfig (memory=10GB), then wsl --shutdown" ;;
        *)   echo "   << LOW: the desktop plus a 2-node cluster wants ~9GB" ;;
      esac
    else
      echo "   ok"
    fi

    avail=$(docker run --rm -v /var/lib/docker alpine:3.21 \
      sh -c 'df -Pk /var/lib/docker | awk "NR==2{print int(\$4/1024/1024)}"' 2>/dev/null || echo "?")
    printf 'disk for images   : %sGB' "$avail"
    if [ "$avail" != "?" ] && [ "$avail" -lt 25 ]; then echo "   << LOW: images alone are ~10GB"; else echo "   ok"; fi

    printf 'cgroup version    : '
    cg=$(docker info --format '{{.CgroupVersion}}' 2>/dev/null || echo "unknown")
    if [ "$cg" = "1" ]; then
      echo "1   << the instances need cgroup v2 (compose sets cgroup: host)"
    else
      echo "$cg"
    fi

    printf 'warm volumes      : '
    warm=$(docker volume ls -q --filter name=kubestronaut-sim 2>/dev/null | wc -l | tr -d ' ')
    if [ "$warm" = "0" ]; then
      echo "none — this will be a cold first boot (slowest path)"
    else
      echo "${warm} present — boot will resume rather than rebuild"
    fi

    if [ "$host" = "WSL" ]; then
      printf 'clone location    : '
      case "$PWD" in
        /mnt/*) echo "on the Windows filesystem — bind mounts will be slow; clone inside ~/ instead" ;;
        *)      echo "WSL filesystem   ok" ;;
      esac
    fi
    if [ "$host" = "Linux" ]; then
      printf 'docker access     : '
      if docker info >/dev/null 2>&1; then
        echo "ok"
      else
        echo "cannot reach the daemon as $(id -un) — add yourself to the docker group, or use sudo"
      fi
    fi

    printf 'exam UI           : '
    if curl -fsS --max-time 3 "${UI}/api/boot" >/dev/null 2>&1; then
      echo "up (state: $(curl -fsS --max-time 3 "${UI}/api/boot" | json_field state))"
    else
      echo "not running"
    fi ;;
  reset)

    echo "Resetting exam state via conductor (cluster + instances, cached images kept)..."

    if ! reset_err=$(curl -fsS -X POST "${UI}/api/control/reset" 2>&1 >/dev/null); then
      echo "The conductor would not accept a reset: ${reset_err:-no answer from ${UI}}"
      echo "It is busy while a bank switch, a reseed, or the preparation of a drawn"
      echo "attempt is running. See what it is doing with:"
      echo "  curl -s ${UI}/api/control/status"
      exit 1
    fi
    while :; do
      sleep 3
      status=$(curl -fsS "${UI}/api/control/status" 2>/dev/null) || continue
      busy=$(printf '%s' "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin)["busy"])')
      [ "$busy" = "False" ] && break
    done
    err=$(printf '%s' "$status" | python3 -c 'import json,sys; print((json.load(sys.stdin).get("lastJob") or {}).get("error",""))')
    [ -z "$err" ] || { echo "Reset failed: $err"; exit 1; }
    echo "Fresh exam ready." ;;
  ssh)   docker compose exec "${2:-instance-1}" su - candidate ;;
  status) docker compose ps ;;
  grade) docker compose exec facilitator /entrypoint.sh grade ;;
  help)  echo "usage: ./sim {up [bank]|down|reset|purge [--all]|doctor|ssh [instance]|status|grade}" ;;
  *) echo "usage: ./sim {up [bank]|down|reset|purge [--all]|doctor|ssh [instance]|status|grade}"; exit 1 ;;
esac
