#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
cmd=${1:-help}

UI=http://localhost:8080

# Reads one field out of a JSON object on stdin. python3 rather than jq
# because the reset path below has always used it and it is the one
# interpreter this script can count on.
json_field() { python3 -c "import json,sys; print(json.load(sys.stdin).get('$1',''))" 2>/dev/null || true; }

case "$cmd" in
  up)
    # NOT `--wait`. That waits on the healthcheck with no timeout
    # (compose's default --wait-timeout is 0, i.e. forever) and prints one
    # unmoving word — so a first boot that takes 20 minutes and a first
    # boot that died after 30 seconds look exactly alike. This is what
    # "env-1 stuck at Waiting" was: not a hang, an unreported wait.
    #
    # The facilitator no longer waits for the cluster, so it answers
    # within seconds and /api/boot can narrate the rest. The browser shows
    # the same phases from the same source at the same time.
    # No default bank. `./sim up` brings the shell up and stops there;
    # naming one — `./sim up ckad-mock-01` — additionally builds that
    # exam's environment and waits for it, which is what the smoke suite
    # and anyone who already knows what they want are doing.
    #
    # A warm stack keeps whatever is already active: /shared/bank
    # survives `down`, and every entrypoint prefers the file over this
    # variable, so this only decides what a FRESH environment builds.
    BANK=${2:-} docker compose up -d --build

    budget=${SIM_BOOT_BUDGET:-3600}
    deadline=$((SECONDS + budget))
    last=""
    if [ -z "${2:-}" ]; then
      # Nothing to BUILD, which is not the same as nothing to wait for.
      #
      # This used to return the moment /api/boot answered, which the
      # facilitator does within a second or two of starting. k8s-env is
      # not done at that point: it still has the two phases that are not
      # about any particular exam — the inner Docker daemon, then the
      # chart repository — and it reports `booting` throughout. So the
      # line below printed "Choose an exam" while the browser was still
      # showing a boot screen. Measured at ~8s on a warm laptop; the
      # smoke suite caught it by sampling the state at ~2s.
      #
      # Waiting for the state to SETTLE fixes it and costs those same
      # seconds. It never waits for an exam: `idle` is the expected
      # answer, and it means the shell is up with nothing chosen.
      shell_deadline=$((SECONDS + ${SIM_SHELL_BUDGET:-300}))
      while :; do
        if [ "$SECONDS" -ge "$shell_deadline" ]; then
          echo
          echo "The environment did not finish starting up. Check with:"
          echo "  docker compose logs k8s-env"
          exit 1
        fi
        boot=$(curl -fsS --max-time 5 "${UI}/api/boot" 2>/dev/null) || { sleep 2; continue; }
        state=$(printf '%s' "$boot" | json_field state)
        label=$(printf '%s' "$boot" | json_field label)
        if [ -n "$label" ] && [ "$label" != "$last" ]; then
          echo "  $label"
          last="$label"
        fi
        case "$state" in
          idle)
            echo "Ready. Choose an exam at ${UI} — its environment is built when you pick one."
            exit 0 ;;
          ready)
            # A warm stack whose exam survived a `down`. Nothing was
            # chosen just now, so say what is actually there rather than
            # inviting a choice that has already been made.
            echo "Exam environment ready. Exam UI: ${UI} — or ./sim ssh instance-1"
            exit 0 ;;
          failed)
            echo
            echo "The environment failed to start:"
            printf '  %s\n' "$(printf '%s' "$boot" | json_field error)"
            echo
            echo "Full output:  docker compose logs k8s-env"
            exit 1 ;;
        esac
        sleep 2
      done
    fi
    echo "Building the exam environment (first run pulls and seeds; later runs resume)..."
    while :; do
      if [ "$SECONDS" -ge "$deadline" ]; then
        echo
        echo "Gave up waiting after ${budget}s. The environment may still be working;"
        echo "check with:  docker compose logs -f k8s-env"
        echo "Raise the budget with SIM_BOOT_BUDGET=<seconds> ./sim up"
        exit 1
      fi

      boot=$(curl -fsS --max-time 5 "${UI}/api/boot" 2>/dev/null) || { sleep 3; continue; }
      state=$(printf '%s' "$boot" | json_field state)
      label=$(printf '%s' "$boot" | json_field label)
      detail=$(printf '%s' "$boot" | json_field detail)

      line="$label"
      [ -n "$detail" ] && line="$label — $detail"
      if [ "$line" != "$last" ] && [ -n "$line" ]; then
        echo "  $line"
        last="$line"
      fi

      case "$state" in
        ready) break ;;
        failed)
          echo
          echo "The environment failed to start:"
          printf '  %s\n' "$(printf '%s' "$boot" | json_field error)"
          echo
          echo "Full output:  docker compose logs k8s-env"
          exit 1 ;;
      esac
      sleep 3
    done
    echo "Exam environment ready. Exam UI: ${UI} — or ./sim ssh instance-1" ;;
  down)  docker compose down --remove-orphans ;;
  purge)
    # This was `docker compose down -v`, which takes EVERY volume with it
    # — including state, where every attempt the candidate has ever
    # graded lives. Purge is what people run when the environment is
    # wedged, i.e. precisely the moment losing five certifications of
    # progress would hurt most, and nothing warned them.
    #
    # So: down without -v, then remove the project's volumes by name,
    # skipping the one compose labelled `state`. The labels are compose's
    # own (com.docker.compose.project / .volume), so nothing here has to
    # guess at the "<project>_<name>" convention or hardcode the project.
    case "${2:-}" in
      "")
        # Resolved BEFORE anything is torn down, so the failure path can
        # honestly say nothing happened. Doing it after the `down` left
        # this branch printing "Nothing was removed" with the containers
        # and networks already gone.
        project=$(docker compose config --format json 2>/dev/null | json_field name)
        if [ -z "$project" ]; then
          echo "Could not determine the compose project name; refusing to guess which"
          echo "volumes are ours. Nothing was removed — the environment is untouched."
          echo "Remove everything, attempt history included, with: ./sim purge --all"
          exit 1
        fi
        docker compose down --remove-orphans
        kept=0
        for vol in $(docker volume ls -q --filter "label=com.docker.compose.project=${project}"); do
          key=$(docker volume inspect -f '{{index .Labels "com.docker.compose.volume"}}' "$vol" 2>/dev/null || true)
          if [ "$key" = "state" ]; then kept=1; continue; fi
          docker volume rm "$vol" >/dev/null || echo "  could not remove ${vol} (still in use?)"
        done
        if [ "$kept" = "1" ]; then
          echo "Purged. Attempt history was kept — remove it too with: ./sim purge --all"
        else
          echo "Purged. There was no attempt history to keep."
        fi ;;
      --all)
        echo "Removing EVERY volume, including attempt history: every attempt graded on"
        echo "this machine is deleted, there is no backup, and there is no undo."
        echo "(Export it first from the app if you want to keep it.)"
        docker compose down -v --remove-orphans
        echo "Purged, attempt history included." ;;
      *)
        echo "usage: ./sim purge [--all]" >&2
        exit 1 ;;
    esac ;;
  doctor)
    # The first-run failures that are not this project's fault are almost
    # all environmental, and all of them are cheaper to find here than
    # twenty minutes into a boot.
    echo "kubestronaut-sim preflight"
    echo
    printf 'docker            : '; docker version --format '{{.Server.Version}}' 2>/dev/null || echo "NOT REACHABLE"
    printf 'compose           : '; docker compose version --short 2>/dev/null || echo "MISSING"
    printf 'python3           : '; python3 --version 2>/dev/null || echo "MISSING (./sim up needs it)"

    mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
    memgb=$(( mem / 1024 / 1024 / 1024 ))
    printf 'RAM to docker     : %sGB' "$memgb"
    if [ "$memgb" -lt 8 ]; then echo "   << LOW: the desktop plus a 2-node cluster wants ~9GB"; else echo "   ok"; fi

    avail=$(docker run --rm -v /var/lib/docker alpine:3.21 df -Pk /var/lib/docker 2>/dev/null | awk 'NR==2{print int($4/1024/1024)}' || echo "?")
    printf 'disk for images   : %sGB' "$avail"
    if [ "$avail" != "?" ] && [ "$avail" -lt 25 ]; then echo "   << LOW: images alone are ~10GB"; else echo "   ok"; fi

    printf 'cgroup version    : '; docker info --format '{{.CgroupVersion}}' 2>/dev/null || echo "unknown"

    printf 'warm volumes      : '
    warm=$(docker volume ls -q --filter name=kubestronaut-sim 2>/dev/null | wc -l | tr -d ' ')
    if [ "$warm" = "0" ]; then
      echo "none — this will be a cold first boot (slowest path)"
    else
      echo "${warm} present — boot will resume rather than rebuild"
    fi

    printf 'exam UI           : '
    if curl -fsS --max-time 3 "${UI}/api/boot" >/dev/null 2>&1; then
      echo "up (state: $(curl -fsS --max-time 3 "${UI}/api/boot" | json_field state))"
    else
      echo "not running"
    fi ;;
  reset)
    # Same code path the UI's "New attempt" button uses: the conductor
    # owns the reset sequence; this is just a thin trigger + progress
    # poll against the facilitator's /api/control proxy.
    echo "Resetting exam state via conductor (cluster + instances, cached images kept)..."
    # The conductor refuses a reset while another job holds it: a bank
    # switch, a reseed, or — since pooling — the seed job that prepares a
    # pooled bank's cluster for the questions an attempt just drew. Bare
    # `curl -fsS` exits 22 there and `set -e` takes this script with it,
    # printing nothing at all, which reads as "reset does nothing".
    if ! reset_err=$(curl -fsS -X POST "${UI}/api/control/reset" 2>&1 >/dev/null); then
      echo "The conductor would not accept a reset: ${reset_err:-no answer from ${UI}}"
      echo "It is busy while a bank switch, a reseed, or the preparation of a drawn"
      echo "attempt is running. See what it is doing with:"
      echo "  curl -s ${UI}/api/control/status"
      exit 1
    fi
    while :; do
      sleep 3
      status=$(curl -fsS "${UI}/api/control/status" 2>/dev/null) || continue
      busy=$(printf '%s' "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin)["busy"])')
      [ "$busy" = "False" ] && break
    done
    err=$(printf '%s' "$status" | python3 -c 'import json,sys; print((json.load(sys.stdin).get("lastJob") or {}).get("error",""))')
    [ -z "$err" ] || { echo "Reset failed: $err"; exit 1; }
    echo "Fresh exam ready." ;;
  ssh)   docker compose exec "${2:-instance-1}" su - candidate ;;
  status) docker compose ps ;;
  grade) docker compose exec facilitator /entrypoint.sh grade ;;
  help)  echo "usage: ./sim {up [bank]|down|reset|purge [--all]|doctor|ssh [instance]|status|grade}" ;;
  *) echo "usage: ./sim {up [bank]|down|reset|purge [--all]|doctor|ssh [instance]|status|grade}"; exit 1 ;;
esac
